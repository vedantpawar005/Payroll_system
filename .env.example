# Appwrite API Client Configuration
# Fill in these values to automatically switch the application from Demo Mode (LocalStorage)
# to live Appwrite Cloud Sync.

VITE_APPWRITE_ENDPOINT=YOUR_APPWRITE_ENDPOINT
VITE_APPWRITE_PROJECT_ID=YOUR_APPWRITE_PROJECT_ID
VITE_APPWRITE_DATABASE_ID=payroll_db

# Appwrite Collection IDs
VITE_APPWRITE_EMPLOYEES_COLLECTION_ID=employees
VITE_APPWRITE_PAYROLLS_COLLECTION_ID=payrolls
